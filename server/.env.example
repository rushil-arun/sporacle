LOBBY_TIME=60
# Bind address for the HTTP server
SERVER_BASE_URL=":8080"
# Publicly advertised address (used for Redis routing and WS URL generation)
SERVER_ADDR="localhost:8080"
# Redis connection address
REDIS_ADDR="localhost:6379"
# Scheme used when returning WebSocket URLs to clients ("ws" or "wss").
# Set to "wss" when running behind a TLS-terminating reverse proxy.
WS_SCHEME="ws"
